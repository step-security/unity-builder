{
  "name": "unity-builder",
  "version": "3.0.0",
  "description": "Build Unity projects for different platforms.",
  "main": "dist/index.js",
  "repository": "git@github.com:step-security/unity-builder.git",
  "author": "step-security",
  "license": "MIT",
  "scripts": {
    "build": "yarn && tsc && ncc build lib --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "yarn oxlint --report-unused-disable-directives",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit"
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "@actions/cache": "^5.0.0",
    "@actions/core": "^2.0.0",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^8.0.0",
    "axios": "1.18.0",
    "md5": "^2.3.0",
    "nanoid": "^3.3.12",
    "semver": "^7.7.4",
    "ts-md5": "^1.3.1",
    "unity-changeset": "^3.1.0",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/node": "^17.0.23",
    "@types/semver": "^7.3.9",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vercel/ncc": "^0.36.1",
    "@vitest/coverage-istanbul": "^4.1.5",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "ts-node": "10.8.1",
    "typescript": "4.7.4",
    "vite": "^7",
    "vitest": "^4",
    "yarn-audit-fix": "^9.3.8"
  },
  "packageManager": "yarn@4.14.1"
}
